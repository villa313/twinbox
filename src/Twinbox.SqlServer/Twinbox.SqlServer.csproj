<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <Description>SQL Server storage for Twinbox with plain ADO.NET or Dapper: save outbox messages in your own SqlTransaction.</Description>
    <PackageTags>$(PackageTags);sqlserver;dapper;ado-net</PackageTags>
    <!-- Microsoft.Data.SqlClient isn't trim or AOT safe, so this package makes no AOT promise. -->
    <IsAotCompatible>false</IsAotCompatible>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../Twinbox/Twinbox.csproj" />
    <PackageReference Include="Microsoft.Data.SqlClient" />
    <Compile Include="../Shared/Sql/*.cs" LinkBase="Shared/Sql" />
    <Compile Include="../Shared/Relational/*.cs" LinkBase="Shared/Relational" />
  </ItemGroup>
</Project>
